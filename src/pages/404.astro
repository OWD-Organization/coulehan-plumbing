---
import Base from "../layouts/Base.astro";
import Drop from "../components/Drop.astro";
---

<Base title="Page not found" description="That page is not on the Coulehan Plumbing site.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow"><Drop size={16} /> 404</p>
      <h1>That page isn’t here.</h1>
      <p class="lede">There is no page at this address.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-line-dark" href="/work/">Examples of My Work</a>
      </div>
    </div>
  </header>
</Base>
