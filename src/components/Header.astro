---
import Photo from "./Photo.astro";
import { moreServices, nav, servicePages, site, towns } from "../data/site";

const path = Astro.url.pathname;

function current(href: string) {
  if (href === "/") return path === "/" ? "page" : undefined;
  return path.startsWith(href) ? "page" : undefined;
}
---

<header class="site-header">
  <p class="hours-bar">{site.hours}</p>
  <div class="container bar">
    <a class="brand" href="/">
      <Photo
        group="brand"
        id="mark"
        alt=""
        sizes="72px"
        loading="eager"
        fetchpriority="low"
      />
      <span class="brand-name">
        <span>Coulehan</span>
        <span>Plumbing</span>
      </span>
    </a>
    <button class="nav-scrim" type="button" aria-label="Close menu" tabindex="-1"></button>
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <div class="mobile-menu-head">
        <button class="menu-close" type="button">Close</button>
      </div>
      {
        nav.map((item) =>
          item.href === "/services/" ? (
            <div class="nav-drop">
              <a class="nav-link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
              <button
                class="sub-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="services-menu"
              >
                <span class="sub-toggle-label">Services</span>
                <span class="sub-toggle-hint">Show services</span>
                <svg class="chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                  <path fill="currentColor" d="M5.2 7.5 10 12.3l4.8-4.8 1.2 1.2L10 14.7 4 8.7z" />
                </svg>
              </button>
              <div id="services-menu" class="submenu">
                <a class="submenu-all" href="/services/" aria-current={path === "/services/" ? "page" : undefined}>
                  All services
                </a>
                <div class="submenu-col" role="group" aria-labelledby="service-pages-label">
                  <p class="submenu-label" id="service-pages-label">Primary Services</p>
                  {servicePages.map((page) => (
                    <a href={page.href} aria-current={current(page.href)}>
                      {page.label}
                    </a>
                  ))}
                </div>
                <div class="submenu-col" role="group" aria-labelledby="more-services-label">
                  <p class="submenu-label" id="more-services-label">Other Services</p>
                  {moreServices.map((page) => (
                    <a href={page.href}>{page.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ) : item.href === "/service-area/" ? (
            <div class="nav-drop nav-drop-area">
              <a class="nav-link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
              <button
                class="sub-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="service-area-menu"
              >
                <span class="sub-toggle-label">Service Area</span>
                <span class="sub-toggle-hint">Show service areas</span>
                <svg class="chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                  <path fill="currentColor" d="M5.2 7.5 10 12.3l4.8-4.8 1.2 1.2L10 14.7 4 8.7z" />
                </svg>
              </button>
              <div id="service-area-menu" class="submenu">
                <a class="submenu-all" href="/service-area/" aria-current={path === "/service-area/" ? "page" : undefined}>
                  All service areas
                </a>
                <div class="submenu-towns">
                  {towns.map((town) => (
                    <a href={`/service-area/${town.slug}/`} aria-current={current(`/service-area/${town.slug}/`)}>
                      {town.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a class="nav-link" href={item.href} aria-current={current(item.href)}>
              {item.label}
            </a>
          ),
        )
      }
      <a class="mobile-call" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
    </nav>
    <div class="header-tools">
      <a class="nav-phone" href={`tel:${site.phoneTel}`}>
        <span class="nav-phone-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </span>
        <span class="nav-phone-text">
          <span class="nav-phone-label">{site.hours}</span>
          <span class="nav-phone-number">{site.phoneDisplay}</span>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <span class="menu-word">MENU</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.querySelector(".nav-toggle");
  const navEl = document.querySelector("#site-nav");
  const drops = [...document.querySelectorAll(".nav-drop")];
  const scrim = document.querySelector(".nav-scrim");
  const menuClose = document.querySelector(".menu-close");
  const desktop = window.matchMedia("(min-width: 1024px)");

  function setDropOpen(drop: Element, open: boolean) {
    const button = drop.querySelector(".sub-toggle");
    if (!(button instanceof HTMLButtonElement)) return;
    button.setAttribute("aria-expanded", open ? "true" : "false");
    drop.classList.toggle("is-open", open);
  }

  function closeDrops(except?: Element) {
    for (const drop of drops) {
      if (drop !== except) setDropOpen(drop, false);
    }
  }

  if (header && toggle && navEl) {
    const close = () => {
      header.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-open");
      closeDrops();
    };
    const openMenu = () => {
      header.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      document.body.classList.add("nav-open");
    };
    toggle.addEventListener("click", () => {
      if (header.classList.contains("is-open")) close();
      else openMenu();
    });
    scrim?.addEventListener("click", close);
    menuClose?.addEventListener("click", close);
    navEl.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest("a")) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const focusedDrop = drops.find((drop) => drop.contains(document.activeElement));
      const focusedToggle = focusedDrop?.querySelector(".sub-toggle");
      close();
      if (focusedToggle instanceof HTMLButtonElement) focusedToggle.focus();
      else if (toggle instanceof HTMLButtonElement) toggle.focus();
    });
  }

  for (const drop of drops) {
    const subToggle = drop.querySelector(".sub-toggle");
    if (!(subToggle instanceof HTMLButtonElement)) continue;
    subToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const open = subToggle.getAttribute("aria-expanded") === "true";
      if (!open) closeDrops(drop);
      setDropOpen(drop, !open);
    });
    drop.addEventListener("mouseenter", () => {
      if (!desktop.matches) return;
      closeDrops(drop);
      setDropOpen(drop, true);
    });
    drop.addEventListener("mouseleave", () => {
      if (!desktop.matches) return;
      if (drop.contains(document.activeElement)) return;
      setDropOpen(drop, false);
    });
    drop.addEventListener("focusin", () => {
      if (!desktop.matches) return;
      closeDrops(drop);
      setDropOpen(drop, true);
    });
    drop.addEventListener("focusout", (event) => {
      if (!desktop.matches) return;
      const next = event.relatedTarget;
      if (next instanceof Node && drop.contains(next)) return;
      setDropOpen(drop, false);
    });
  }
</script>
