---
import Photo from "./Photo.astro";
import { nav, site } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Photo group="brand" id="logo" alt="Coulehan Plumbing logo" sizes="96px" />
      <p>
        <strong>{site.name}</strong><br />
        {site.slogan}
      </p>
      <p class="fine">
        {site.addressLine}. Owner-operated. Jerry Coulehan, Master Plumber.
      </p>
    </div>
    <div>
      <h2>Pages</h2>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.facebook}>Facebook</a></li>
        <li><a href={site.google}>Google Business</a></li>
      </ul>
      <p class="fine">
        Hours: TODO. Facebook says “Always open.” The old website hours block
        (8am–5pm) is broken. 24-hour emergency service is what the current site
        advertises. Confirm the real hours with Jerry.
      </p>
    </div>
  </div>
</footer>

<div class="callbar">
  <a class="btn btn-light" href={`tel:${site.phoneTel}`}>Call</a>
  <a class="btn btn-line" href="/contact/">Request a quote</a>
</div>
