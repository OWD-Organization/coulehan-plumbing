---
import { site } from "../data/site";
---

<section class="cta-band">
  <div class="container">
    <p class="eyebrow">Coulehan Plumbing LLC</p>
    <h2>Call, or ask for a quote.</h2>
    <p>
      Owner-operated plumbing in Pittsburgh. Repairs, remodels, sewer work, and
      24-hour emergency service.
    </p>
    <div class="cta-row">
      <a class="btn btn-light" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
      <a class="btn btn-line" href="/contact/">Request a quote</a>
    </div>
  </div>
</section>
