---
import Photo from "./Photo.astro";
import Drop from "./Drop.astro";
import { categoryLabel, coverId, formatDate, type Job } from "../data/jobs";

interface Props {
  job: Job;
  heading?: "h2" | "h3";
}
const { job, heading = "h2" } = Astro.props;
const Title = heading;
const cover = coverId(job);
const cats = job.categories.filter((slug) => slug !== "video").map(categoryLabel);
---

<article class="job-card" data-cats={job.categories.join(" ")}>
  <a href={`/work/${job.slug}/`}>
    <div class="job-card-media">
      {
        cover ? (
          <Photo
            group={`jobs/${job.slug}`}
            id={cover}
            alt=""
            sizes="(min-width: 1100px) 30vw, (min-width: 720px) 45vw, 100vw"
          />
        ) : (
          <div class="video-fallback">
            <Drop size={48} />
            <span>Video on Facebook</span>
          </div>
        )
      }
    </div>
    <div class="job-card-body">
      <p class="meta">
        <time datetime={job.date}>{formatDate(job.date)}</time>
        {cats.length > 0 && ` · ${cats.join(" · ")}`}
      </p>
      <Title>{job.title}</Title>
      <p>{job.excerpt}</p>
    </div>
  </a>
</article>
